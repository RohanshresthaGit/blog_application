<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
</head>
<body class="bg-light">

    <%- include('./partials/navbar') %>

    <div class="container py-5">

        <!-- Hero -->
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">Latest Blogs</h1>
            <p class="text-muted">
                Discover stories, ideas, and insights from our community.
            </p>
        </div>

        <% if (blogs.length === 0) { %>

            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <h4 class="fw-bold">No Blogs Yet</h4>
                    <p class="text-muted mb-4">
                        Be the first one to publish a blog.
                    </p>
                    <a href="/blog/add" class="btn btn-primary">
                        Create Blog
                    </a>
                </div>
            </div>

        <% } else { %>

        <div class="row g-4">

            <% blogs.forEach(blog => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm">

                        <img
                            src="<%= blog.coverImage %>"
                            class="card-img-top"
                            style="height:230px; object-fit:cover;"
                            alt="<%= blog.title %>">

                        <div class="card-body d-flex flex-column">

                            <span class="badge bg-primary mb-2 align-self-start">
                                Blog
                            </span>

                            <h4 class="card-title fw-bold">
                                <%= blog.title %>
                            </h4>

                            <p class="card-text text-muted">
                                <%= blog.content.length > 120
                                    ? blog.content.substring(0,120) + "..."
                                    : blog.content %>
                            </p>

                            <div class="mt-auto">

                                <hr>

                                <div class="d-flex justify-content-between align-items-center">

                                    <small class="text-muted">
                                        <i class="bi bi-calendar-event"></i>
                                        <%= blog.createdAt.toDateString() %>
                                    </small>

                                    <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary">
                                        Read More →
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

        <% } %>

    </div>

    <%- include('./partials/scripts') %>

</body>
</html>