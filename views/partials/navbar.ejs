<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">

        <!-- Brand -->
        <a class="navbar-brand fw-bold" href="/">
            <i class="bi bi-journal-richtext me-2"></i>
            Blogify
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="navbarNav">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <% if (locals.user) { %>

                    <li class="nav-item me-lg-2">
                        <a class="nav-link" href="/">
                            <i class="bi bi-house-door me-1"></i>
                            Home
                        </a>
                    </li>

                    <li class="nav-item me-lg-3">
                        <a class="btn btn-primary" href="/blog/add">
                            <i class="bi bi-plus-circle me-1"></i>
                            Create Blog
                        </a>
                    </li>

                    <li class="nav-item dropdown">

                        <a
                            class="nav-link dropdown-toggle d-flex align-items-center"
                            href="#"
                            id="userDropdown"
                            role="button"
                            data-bs-toggle="dropdown">

                            <span class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center me-2"
                                style="width:38px;height:38px;">

                                <%= locals.user.fullName.charAt(0).toUpperCase() %>

                            </span>

                            <span class="fw-semibold">
                                <%= locals.user.fullName %>
                            </span>

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li>
                                <h6 class="dropdown-header">
                                    Signed in as
                                </h6>
                            </li>

                            <li>
                                <span class="dropdown-item-text text-muted">
                                    <%= locals.user.email %>
                                </span>
                            </li>

                            <li><hr class="dropdown-divider"></li>


                            <li>
                                <a class="dropdown-item text-danger" href="/user/logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </a>
                            </li>

                        </ul>

                    </li>

                <% } else { %>

                    <li class="nav-item me-2">
                        <a href="/user/login" class="btn btn-outline-light">
                            Login
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/user/register" class="btn btn-primary">
                            Register
                        </a>
                    </li>

                <% } %>

            </ul>

        </div>

    </div>
</nav>

<% if (locals.error) { %>

<div class="container mt-3">

    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        <%= locals.error %>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert">
        </button>

    </div>

</div>

<% } %>