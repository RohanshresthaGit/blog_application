<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>
            <%= blog.title %>
        </title>
</head>

<body class="bg-light">

    <%- include('./partials/navbar') %>

        <div class="container py-5">

            <div class="row justify-content-center">

                <div class="col-lg-9">

                    <!-- ================= BLOG CARD ================= -->

                    <div class="card border-0 shadow mb-5">

                        <!-- Cover Image -->
                        <img src="<%= blog.coverImage %>" class="card-img-top" alt="<%= blog.title %>"
                            style="height: 450px; object-fit: cover;">

                        <div class="card-body p-5">

                            <span class="badge bg-primary mb-3">
                                Blog
                            </span>

                            <h1 class="display-5 fw-bold mb-3">
                                <%= blog.title %>
                            </h1>

                            <div class="d-flex justify-content-between flex-wrap mb-4">

                                <div class="text-muted">
                                    <strong>Published:</strong>
                                    <%= blog.createdAt.toDateString() %>
                                </div>

                                <% if(blog.createdBy){ %>
                                    <div class="text-muted">
                                        <strong>Author:</strong>
                                        <%= blog.createdBy.fullName %>
                                    </div>
                                    <% } %>

                            </div>

                            <hr>

                            <div class="fs-5 lh-lg mt-4">
                                <%= blog.content %>
                            </div>

                            <hr class="my-4">

                            <div class="d-flex justify-content-between align-items-center">

                                <a href="/" class="btn btn-outline-secondary">
                                    ← Back to Blogs
                                </a>

                                <% if(blog.createdBy){ %>
                                    <small class="text-muted">
                                        Written by
                                        <strong>
                                            <%= blog.createdBy.fullName %>
                                        </strong>
                                    </small>
                                    <% } %>

                            </div>

                        </div>

                    </div>

                    <!-- ================= COMMENTS CARD ================= -->

                    <div class="card border-0 shadow">

                        <div class="card-body p-5">

                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <h3 class="mb-0">
                                    Comments
                                </h3>

                                <span class="badge bg-primary fs-6">
                                    <%= comments ? comments.length : 0 %>
                                </span>

                            </div>

                            <!-- Comment Form -->

                            <% if(user){ %>

                                <form action="/blog/<%= blog._id %>/comment" method="POST">

                                    <div class="mb-3">

                                        <textarea name="comment" class="form-control" rows="4"
                                            placeholder="Share your thoughts..." required></textarea>

                                    </div>

                                    <button class="btn btn-primary">
                                        Post Comment
                                    </button>

                                </form>

                                <% }else{ %>

                                    <div class="alert alert-info">

                                        Please
                                        <a href="/user/signin">Sign In</a>
                                        to leave a comment.

                                    </div>

                                    <% } %>

                                        <hr class="my-5">

                                        <!-- Comment List -->

                                        <% if(comments && comments.length> 0){ %>

                                            <% comments.forEach(comment=> { %>

                                                <div class="d-flex mb-4">

                                                    <!-- Avatar -->

                                                    <div class="flex-shrink-0">

                                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                                            style="width:50px;height:50px;font-weight:bold;font-size:18px;">

                                                            <%= comment.commentedBy.fullName.charAt(0).toUpperCase() %>

                                                        </div>

                                                    </div>


                                                    <div class="ms-3 flex-grow-1">


                                                        <div
                                                            class="d-flex justify-content-between align-items-center mb-0">

                                                            <h6 class="mb-0 fw-bold">
                                                                <%= comment.commentedBy.fullName %>
                                                            </h6>

                                                            <small class="text-muted">
                                                                <%= comment.createdAt.toDateString() %>
                                                            </small>

                                                        </div>

                                                        <p class="mb-2">
                                                            <%= comment.comment %>
                                                        </p>

                                                        <div id="comment" class="d-flex align-items-center gap-2">

                                                            <form action="/comment/<%= comment._id %>/like"
                                                                method="POST" class="m-0">
                                                                <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                    ❤️ Like
                                                                </button>
                                                            </form>

                                                            <span class="text-muted">
                                                                <strong>
                                                                    <%= comment.likes || 0 %>
                                                                </strong>
                                                                <%= (comment.likes || 0)===1 ? "Like" : "Likes" %>
                                                            </span>

                                                        </div>


                                                    </div>

                                                </div>

                                                <% }) %>

                                                    <% }else{ %>

                                                        <div class="text-center py-5">

                                                            <i
                                                                class="bi bi-chat-left-text display-4 text-secondary"></i>

                                                            <h5 class="mt-3">
                                                                No comments yet
                                                            </h5>

                                                            <p class="text-muted mb-0">
                                                                Be the first to start the discussion.
                                                            </p>

                                                        </div>

                                                        <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <%- include('./partials/scripts') %>

</body>

</html>