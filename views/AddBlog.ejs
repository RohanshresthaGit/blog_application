<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Create Blog</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>

<body class="bg-light">

    <%- include('./partials/navbar') %>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow border-0 rounded-4">

                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <h2 class="fw-bold">Create New Blog</h2>
                            <p class="text-muted">
                                Share your story with everyone.
                            </p>
                        </div>

                        <form action="/blog/add" method="POST" enctype="multipart/form-data">

                            <!-- Cover Image -->
                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Cover Image
                                </label>

                                <!-- Hidden Input -->
                                <input
                                    type="file"
                                    class="d-none"
                                    id="coverImage"
                                    name="coverImage"
                                    accept="image/*"
                                    required>

                                <!-- Upload Area -->
                                <label for="coverImage"
                                    class="border border-2 border-secondary-subtle rounded-4 p-5 text-center w-100">

                                    <i class="bi bi-cloud-arrow-up display-4 text-primary"></i>

                                    <h5 class="mt-3">
                                        Click to upload an image
                                    </h5>

                                    <p class="text-muted mb-2">
                                        PNG, JPG or JPEG
                                    </p>

                                    <span id="fileName" class="badge bg-secondary">
                                        No file selected
                                    </span>

                                </label>

                            </div>

                            <!-- Title -->
                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Blog Title
                                </label>

                                <input
                                    type="text"
                                    class="form-control form-control-lg"
                                    name="title"
                                    placeholder="Enter your blog title"
                                    required>

                            </div>

                            <!-- Content -->
                            <div class="mb-4">

                                <label class="form-label fw-semibold">
                                    Content
                                </label>

                                <textarea
                                    class="form-control"
                                    rows="10"
                                    name="content"
                                    placeholder="Write your blog..."
                                    required></textarea>

                            </div>

                            <div class="d-flex justify-content-end">

                                <button class="btn btn-primary btn-lg px-5">
                                    Publish Blog
                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <%- include('./partials/scripts') %>

    <script>
        const fileInput = document.getElementById("coverImage");
        const fileName = document.getElementById("fileName");

        fileInput.addEventListener("change", function () {
            if (this.files.length > 0) {
                fileName.textContent = this.files[0].name;
                fileName.classList.remove("bg-secondary");
                fileName.classList.add("bg-success");
            }
        });
    </script>

</body>
</html>